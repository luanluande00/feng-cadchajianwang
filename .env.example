# 数据库配置（Vercel Postgres 或 Supabase）
DATABASE_URL="postgresql://user:pass@host:5432/dbname?schema=public"

# JWT配置（必须修改为强随机字符串！）
JWT_SECRET="CHANGE-ME-TO-A-SECURE-RANDOM-STRING"
JWT_EXPIRES_IN="7d"

# 邮件服务配置（推荐使用 Resend / EmailJS / SMTP）
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@cybercad.com"

# 支付配置（支付宝 - 按需填写）
ALIPAY_APP_ID=""
ALIPAY_PRIVATE_KEY=""
ALIPAY_PUBLIC_KEY=""
ALIPAY_GATEWAY="https://openapi-sandbox.alipay.com/gateway.do"

# 文件存储（Vercel Blob - 可选）
BLOB_READ_WRITE_TOKEN=""

# 应用配置
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"
REGISTER_BONUS_POINTS=100
PLUGIN_SELLER_REVENUE_PERCENT=70
MIN_WITHDRAW_POINTS=1000
