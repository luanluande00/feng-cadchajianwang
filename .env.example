# 数据库配置
DATABASE_URL="postgresql://postgres:password@localhost:5432/cybercad?schema=public"

# JWT配置
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# 邮件服务配置
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your-email@example.com"
SMTP_PASS="your-email-password"
SMTP_FROM="noreply@cybercad.com"

# 支付配置（支付宝）
ALIPAY_APP_ID=""
ALIPAY_PRIVATE_KEY=""
ALIPAY_PUBLIC_KEY=""
ALIPAY_GATEWAY="https://openapi.alipay.com/gateway.do"

# 文件存储（Vercel Blob）
BLOB_READ_WRITE_TOKEN=""

# 应用配置
NEXT_PUBLIC_APP_URL="http://localhost:3000"
REGISTER_BONUS_POINTS=100
PLUGIN_SELLER_REVENUE_PERCENT=70
MIN_WITHDRAW_POINTS=1000
